        "import pandas as pd\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import accuracy_score, confusion_matrix\n",
        "from sklearn.neural_network import MLPClassifier\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "\n",
        "# 1. Деректерді құру\n",
        "data = [\n",
        "    [1, 0.20, 0.10, 0.80, 0.10, 1],\n",
        "    [2, 0.30, 0.20, 0.70, 0.20, 1],\n",
        "    [3, 0.40, 0.15, 0.90, 0.15, 1],\n",
        "    [4, 0.50, 0.30, 0.80, 0.10, 1],\n",
        "    [5, 0.60, 0.25, 0.75, 0.20, 1],\n",
        "    [6, 0.70, 0.35, 0.85, 0.10, 1],\n",
        "    [7, 0.80, 0.40, 0.90, 0.15, 1],\n",
        "    [8, 0.25, 0.50, 0.70, 0.40, 1],\n",
        "    [9, 0.35, 0.45, 0.80, 0.35, 1],\n",
        "    [10, 0.45, 0.55, 0.75, 0.45, 1],\n",
        "    [11, 0.55, 0.50, 0.85, 0.30, 1],\n",
        "    [12, 0.65, 0.60, 0.80, 0.40, 1],\n",
        "    [13, 0.20, 0.80, 0.40, 0.75, 0],\n",
        "    [14, 0.30, 0.70, 0.35, 0.80, 0],\n",
        "    [15, 0.40, 0.85, 0.45, 0.70, 0],\n",
        "    [16, 0.50, 0.75, 0.30, 0.85, 0],\n",
        "    [17, 0.60, 0.90, 0.40, 0.80, 0],\n",
        "    [18, 0.70, 0.80, 0.35, 0.90, 0],\n",
        "    [19, 0.80, 0.85, 0.45, 0.75, 0],\n",
        "    [20, 0.90, 0.70, 0.30, 0.85, 0],\n",
        "    [21, 0.25, 0.90, 0.50, 0.80, 0],\n",
        "    [22, 0.45, 0.95, 0.40, 0.90, 0],\n",
        "    [23, 0.65, 0.85, 0.30, 0.95, 0],\n",
        "    [24, 0.85, 0.90, 0.35, 0.85, 0],\n",
        "]\n",
        "columns = ['ID', 'Vibration', 'Slip', 'SurfaceGrip', 'ObstacleRate', 'Stable']\n",
        "df = pd.DataFrame(data, columns=columns)\n",
        "\n",
        "# 2. Бөлу\n",
        "X_train, y_train = (\n",
        "    df[df['ID'] <= 18][['Vibration', 'Slip', 'SurfaceGrip', 'ObstacleRate']],\n",
        "    df[df['ID'] <= 18]['Stable'],\n",
        ")\n",
        "X_test, y_test = (\n",
        "    df[df['ID'] >= 19][['Vibration', 'Slip', 'SurfaceGrip', 'ObstacleRate']],\n",
        "    df[df['ID'] >= 19]['Stable'],\n",
        ")\n",
        "\n",
        "# 3. Оқыту және Болжау\n",
        "dt = DecisionTreeClassifier(random_state=42).fit(X_train, y_train)\n",
        "mlp = MLPClassifier(hidden_layer_sizes=(4,), max_iter=1000, random_state=42).fit(\n",
        "    X_train, y_train\n",
        ")\n",
        "\n",
        "print('DT Test Accuracy:', accuracy_score(y_test, dt.predict(X_test)))\n",
        "print('NN Test Accuracy:', accuracy_score(y_test, mlp.predict(X_test)))"
      ]
    }
  ]
